#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.1"
CONFIG_DIR="${HOME}/.config/ngrok-status"
CONFIG_FILE="${CONFIG_DIR}/config"
ADDRS_URL="https://api.ngrok.com/reserved_addrs"
ENDPOINTS_URL="https://api.ngrok.com/endpoints"
# where the published script and installer live (overridable for testing)
RAW_BASE="${NGROK_STATUS_RAW_BASE:-https://raw.githubusercontent.com/dritory/ngrok-status/main}"
UPDATE_CHECK_EVERY=$(( 6 * 3600 ))  # seconds between checks while the TUI runs

# --- clipboard helper ---

clip_copy() {
    local text="$1"
    if command -v wl-copy &>/dev/null; then
        printf '%s' "$text" | wl-copy
    elif command -v xclip &>/dev/null; then
        printf '%s' "$text" | xclip -selection clipboard
    elif command -v xsel &>/dev/null; then
        printf '%s' "$text" | xsel --clipboard --input
    elif command -v pbcopy &>/dev/null; then
        printf '%s' "$text" | pbcopy
    else
        return 1
    fi
}

# --- config helpers ---

config_load() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
    fi
}

config_set() {
    mkdir -p "$CONFIG_DIR"
    local key="$1" value="$2"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE"; then
        sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$CONFIG_FILE"
    else
        echo "${key}=\"${value}\"" >> "$CONFIG_FILE"
    fi
}

config_get() {
    config_load
    local key="${1:-}"
    if [[ -z "$key" ]]; then
        if [[ -f "$CONFIG_FILE" ]]; then
            while IFS='=' read -r k v; do
                [[ -z "$k" || "$k" == \#* ]] && continue
                v="${v//\"/}"
                if [[ "$k" == "api_key" && -n "$v" ]]; then
                    echo "${k} = ${v:0:4}***${v: -4}"
                else
                    echo "${k} = ${v}"
                fi
            done < "$CONFIG_FILE"
        else
            echo "No config file found. Run: ngrok-status config set api_key <key>"
        fi
    else
        local val="${!key:-}"
        if [[ "$key" == "api_key" && -n "$val" ]]; then
            echo "${key} = ${val:0:4}***${val: -4}"
        else
            echo "${key} = ${val:-<unset>}"
        fi
    fi
}

get_api_key() {
    config_load
    local key="${NGROK_API_KEY:-${api_key:-}}"
    if [[ -z "$key" ]]; then
        echo "Error: ngrok API key not configured." >&2
        echo "Run:  ngrok-status config set api_key <your-key>" >&2
        echo "Get your API key from https://dashboard.ngrok.com/api-keys" >&2
        exit 1
    fi
    echo "$key"
}

# --- update helpers ---

# Prints the version of the published script, or nothing if it cannot be reached.
latest_version() {
    curl -fsSL --max-time 5 "${RAW_BASE}/ngrok-status" 2>/dev/null \
        | sed -n 's/^VERSION="\([0-9][0-9A-Za-z.-]*\)"$/\1/p' | head -n 1
}

# True when version $1 is newer than version $2.
version_gt() {
    [[ "$1" != "$2" ]] || return 1
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]
}

self_update() {
    local installer
    installer="$(mktemp)"
    if ! curl -fsSL --max-time 30 "${RAW_BASE}/install.sh" -o "$installer"; then
        rm -f "$installer"
        echo "Error: could not download the installer from ${RAW_BASE}/install.sh" >&2
        exit 1
    fi
    local rc=0
    bash "$installer" || rc=$?
    rm -f "$installer"
    exit "$rc"
}

# --- ssh config helpers ---

ssh_config_path() {
    echo "${ssh_config:-${HOME}/.ssh/config}"
}

# "bv-Krikkand 2" -> "krikkand-2" (with alias_strip_prefix="bv-").
# The result is left in REPLY, which saves a subshell per row.
ssh_alias_for() {
    local name="$1" prefix="${alias_strip_prefix:-}"
    if [[ -n "$prefix" ]]; then
        name="${name#"$prefix"}"
    fi
    name="${name,,}"
    name="${name//[^a-z0-9._-]/-}"
    while [[ "$name" == *--* ]]; do name="${name//--/-}"; done
    name="${name#-}"
    name="${name%-}"
    REPLY="$name"
}

# Prints "alias<TAB>host:port" for every Host block in the ssh config.
ssh_config_list() {
    local file
    file="$(ssh_config_path)"
    [[ -f "$file" ]] || return 0
    awk '
        function flush() {
            if (alias != "" && host != "") print alias "\t" tolower(host) ":" port
            alias = ""; host = ""; port = 22
        }
        {
            key = tolower($1); sub(/=.*/, "", key)
            if (key == "host" || key == "match") {
                flush()
                if (key == "host" && $2 !~ /[*?!]/) alias = $2
                next
            }
            if (key == "hostname") host = $2
            if (key == "port") port = $2
        }
        END { flush() }
    ' "$file"
}

# Points Host <alias> at host:port. An existing block keeps everything except
# HostName and Port; otherwise a new block is appended. Prints "updated" or "added".
ssh_config_upsert() {
    local alias="$1" host="$2" port="$3" user="${4:-}"
    local file tmp rc=0
    file="$(ssh_config_path)"

    if [[ ! -e "$file" ]]; then
        mkdir -p "$(dirname "$file")"
        ( umask 077; : > "$file" )
    fi

    tmp="$(mktemp)"
    awk -v alias="$alias" -v host="$host" -v port="$port" -v user="$user" '
        function flush_block() {
            if (!in_target) return
            if (!seen_host) print indent "HostName " host
            if (!seen_port) print indent "Port " port
            printf "%s", pending
            pending = ""
            in_target = 0
        }
        {
            last_blank = ($0 ~ /^[ \t]*$/)
            key = tolower($1); sub(/=.*/, "", key)
            if (key == "host" || key == "match") {
                flush_block()
                if (key == "host") {
                    for (i = 2; i <= NF; i++) if ($i == alias) in_target = 1
                    if (in_target) {
                        found = 1; seen_host = 0; seen_port = 0
                        indent = "    "; have_indent = 0
                    }
                }
                print; next
            }
            if (!in_target) { print; next }
            # hold back blank lines so that inserted options land above them
            if (last_blank) { pending = pending $0 "\n"; next }
            printf "%s", pending; pending = ""
            match($0, /^[ \t]*/); cur = substr($0, 1, RLENGTH)
            if (!have_indent) { indent = cur; have_indent = 1 }
            if (key == "hostname") {
                if (!seen_host) print cur "HostName " host
                seen_host = 1; next
            }
            if (key == "port") {
                if (!seen_port) print cur "Port " port
                seen_port = 1; next
            }
            print
        }
        END {
            flush_block()
            if (!found) {
                if (NR > 0 && !last_blank) print ""
                print "Host " alias
                print "    HostName " host
                print "    Port " port
                if (user != "") print "    User " user
            }
            exit(found ? 0 : 3)
        }
    ' "$file" > "$tmp" || rc=$?

    if (( rc != 0 && rc != 3 )); then
        rm -f "$tmp"
        return 1
    fi

    cp -p "$file" "${file}.ngrok-status.bak"
    # write through the existing file so that permissions and symlinks survive
    cat "$tmp" > "$file"
    rm -f "$tmp"
    if (( rc == 3 )); then echo "added"; else echo "updated"; fi
}

# --- watch TUI ---

watch_tui() {
    for cmd in curl jq tput; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "Error: $cmd is required. Install it and try again." >&2
            exit 1
        fi
    done

    local token
    token="$(get_api_key)"
    config_load
    local interval="${refresh_interval:-5}"

    local t_rev t_bold t_dim t_sgr0
    t_rev="$(tput rev)"; t_bold="$(tput bold)"; t_dim="$(tput dim)"; t_sgr0="$(tput sgr0)"
    local el=$'\e[K'

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local result_file="${tmp_dir}/result"
    local fetching=0 fetch_pid="" next_fetch=0 loaded=0
    local update_file="${tmp_dir}/latest"
    local update_pid="" next_update_check=0 update_notice=""

    cleanup() {
        if [[ -n "$fetch_pid" ]]; then kill "$fetch_pid" 2>/dev/null || true; fi
        if [[ -n "$update_pid" ]]; then kill "$update_pid" 2>/dev/null || true; fi
        rm -rf "$tmp_dir"
        tput cnorm; tput sgr0; echo
    }
    trap cleanup EXIT
    trap 'exit 0' INT TERM
    trap 'resized=1; needs_redraw=1' WINCH

    tput civis  # hide cursor
    tput clear

    local sel=0
    local top=0  # index of the first row shown
    local line_count=0
    local status_msg=""
    local status_expire=0
    local needs_redraw=1
    # draw runs on every keypress, so it must not fork: everything it needs
    # (terminal size, timestamp, SSH labels) is worked out ahead of time
    local resized=1
    local term_rows=24 term_cols=80
    local refreshed_at=""
    local labels=()
    local -A ssh_alias_by_addr=()
    local -A ssh_addr_by_alias=()

    load_ssh_map() {
        ssh_alias_by_addr=()
        ssh_addr_by_alias=()
        local a t
        while IFS=$'\t' read -r a t; do
            [[ -z "$a" ]] && continue
            # ssh uses the first block that matches, so we do the same
            [[ -z "${ssh_addr_by_alias[$a]:-}" ]] && ssh_addr_by_alias[$a]="$t"
            [[ -z "${ssh_alias_by_addr[$t]:-}" ]] && ssh_alias_by_addr[$t]="$a"
        done < <(ssh_config_list 2>/dev/null || true)
        return 0
    }

    # Talks to the ngrok API and writes the outcome to $1: a first line of
    # "ok" or "error<TAB>message", followed by one TSV line per address.
    # This runs in the background, so it must not touch the TUI state.
    fetch_to_file() {
        local out="$1" addrs endpoints http_code

        # the two requests are independent, so they run side by side
        curl -s --max-time 10 -w '\n%{http_code}' \
            -H "Authorization: Bearer ${token}" \
            -H "ngrok-version: 2" \
            "$ADDRS_URL" > "${out}.addrs" 2>&1 &
        curl -s --max-time 10 -w '\n%{http_code}' \
            -H "Authorization: Bearer ${token}" \
            -H "ngrok-version: 2" \
            "$ENDPOINTS_URL" > "${out}.endpoints" 2>&1 &
        wait

        addrs="$(< "${out}.addrs")"
        http_code="${addrs##*$'\n'}"
        addrs="${addrs%$'\n'*}"

        if [[ "$http_code" != 200 ]]; then
            local detail
            detail="$(jq -r '.msg // .message // empty' <<< "$addrs" 2>/dev/null || true)"
            printf 'error\tAPI request failed (HTTP %s)%s\n' "$http_code" "${detail:+: ${detail}}" > "${out}.tmp"
            mv "${out}.tmp" "$out"
            return 0
        fi

        endpoints="$(< "${out}.endpoints")"
        http_code="${endpoints##*$'\n'}"
        endpoints="${endpoints%$'\n'*}"

        # build list of connected reserved addr IDs
        local connected_ids=""
        if [[ "$http_code" == 200 ]]; then
            connected_ids="$(jq -r '
                [.endpoints[] | .tcp_addr.id // empty] | unique | join("\n")
            ' <<< "$endpoints" 2>/dev/null || true)"
        fi

        {
            echo "ok"
            jq -r --arg ids "$connected_ids" '
                ($ids | split("\n")) as $connected |
                .reserved_addrs[] |
                (.id // "") as $id |
                (if ($connected | index($id)) then "●" else "○" end) as $status |
                [$status, .description // "—", .addr // "", .region // ""] | @tsv
            ' <<< "$addrs"
        } > "${out}.tmp" 2>/dev/null || printf 'error\tCould not parse the API response\n' > "${out}.tmp"
        # the rename is atomic, so the TUI never sees a half-written result
        mv "${out}.tmp" "$out"
    }

    # A fetch takes about a second, or up to ten when the network is bad. So it
    # runs in the background, and the key loop picks the result up when it is there.
    start_fetch() {
        if (( fetching )); then return 0; fi
        fetching=1
        rm -f "$result_file"
        ( trap - EXIT; fetch_to_file "$result_file" ) < /dev/null > /dev/null 2>&1 &
        fetch_pid=$!
    }

    # Loads a finished fetch into the TUI state. Returns 1 when there is none yet.
    collect_fetch() {
        if (( ! fetching )); then return 1; fi
        if [[ ! -f "$result_file" ]]; then
            # the fetch died without leaving a result: give up on it and retry later
            if kill -0 "$fetch_pid" 2>/dev/null; then return 1; fi
            if [[ ! -f "$result_file" ]]; then
                wait "$fetch_pid" 2>/dev/null || true
                fetching=0
                next_fetch=$(( SECONDS + interval ))
                error="Fetching from the ngrok API failed"
                needs_redraw=1
                return 0
            fi
        fi

        local raw=()
        mapfile -t raw < "$result_file"
        rm -f "$result_file"
        wait "$fetch_pid" 2>/dev/null || true
        fetching=0
        next_fetch=$(( SECONDS + interval ))
        loaded=1

        if [[ "${raw[0]:-}" == ok ]]; then
            error=""
            lines=("${raw[@]:1}")
        else
            # keep showing nothing rather than a list we know is out of date
            error="${raw[0]#error$'\t'}"
            error="${error:-Fetching from the ngrok API failed}"
            lines=()
        fi

        line_count=${#lines[@]}
        if (( sel >= line_count )); then
            sel=$(( line_count > 0 ? line_count - 1 : 0 ))
        fi
        printf -v refreshed_at '%(%H:%M:%S)T' -1
        load_ssh_map
        refresh_labels
        needs_redraw=1
        return 0
    }

    # Looks up the published version in the background, like the fetch above,
    # so that a slow or missing network never holds up the TUI.
    check_for_update() {
        if [[ "${check_updates:-true}" == false ]]; then return 0; fi
        if [[ -n "$update_pid" ]]; then
            if [[ ! -f "$update_file" ]]; then
                if kill -0 "$update_pid" 2>/dev/null; then return 0; fi
                if [[ ! -f "$update_file" ]]; then
                    wait "$update_pid" 2>/dev/null || true
                    update_pid=""
                    return 0
                fi
            fi
            local latest=""
            read -r latest < "$update_file" || true
            rm -f "$update_file"
            wait "$update_pid" 2>/dev/null || true
            update_pid=""
            if [[ -n "$latest" ]] && version_gt "$latest" "$VERSION"; then
                update_notice="Version ${latest} is available (you have ${VERSION}). To update, quit and run: ngrok-status update"
                needs_redraw=1
            fi
        elif (( SECONDS >= next_update_check )); then
            next_update_check=$(( SECONDS + UPDATE_CHECK_EVERY ))
            (
                trap - EXIT
                latest_version > "${update_file}.tmp" || true
                mv "${update_file}.tmp" "$update_file"
            ) < /dev/null > /dev/null 2>&1 &
            update_pid=$!
        fi
    }

    refresh_labels() {
        labels=()
        local i desc addr
        for (( i = 0; i < ${#lines[@]}; i++ )); do
            IFS=$'\t' read -r _ desc addr _ <<< "${lines[$i]}"
            ssh_label_for "$desc" "$addr"
            labels[i]="$REPLY"
        done
    }

    # What the SSH column shows: the alias that points at this address, or the
    # expected alias marked as stale when it points somewhere else.
    ssh_label_for() {
        local desc="$1" addr="$2" alias
        REPLY="${ssh_alias_by_addr[${addr,,}]:-}"
        if [[ -n "$REPLY" ]]; then return 0; fi
        ssh_alias_for "$desc"
        alias="$REPLY"
        REPLY=""
        if [[ -n "$alias" && -n "${ssh_addr_by_alias[$alias]:-}" ]]; then
            REPLY="${alias} (stale)"
        fi
    }

    draw() {
        local buf=""
        if (( resized )); then
            term_cols="$(tput cols)"
            term_rows="$(tput lines)"
            resized=0
        fi
        local cols=$term_cols rows=$term_rows
        local header=" ngrok TCP Addresses  —  refreshed ${refreshed_at}  —  every ${interval}s "
        if [[ -z "$refreshed_at" ]]; then
            header=" ngrok TCP Addresses  —  every ${interval}s "
        fi
        local padded
        # every line is cut to the terminal width, because a wrapped line
        # would throw off the row count that scrolling depends on
        local width=$(( cols - 1 ))

        printf -v padded "%-${cols}s" "$header"
        buf+="${t_rev}${t_bold}${padded:0:cols}${t_sgr0}"$'\n'

        # the line under the header is normally blank; it carries the update notice
        if [[ -n "$update_notice" ]]; then
            local notice=" ${update_notice}"
            buf+=$'\e[33m'"${notice:0:width}"$'\e[0m'
        fi
        buf+="${el}"$'\n'

        if (( ! loaded )) && [[ -z "$error" ]]; then
            buf+="  Loading…${el}"
        elif [[ -n "$error" ]]; then
            local msg="  ${error}"
            buf+="${msg:0:width}${el}"
        elif [[ ${#lines[@]} -eq 0 ]]; then
            buf+="  No TCP addresses found.${el}"
        else
            # 8 lines of the screen are taken up by the header and the footer
            local visible=$(( rows - 8 ))
            if (( visible < 1 )); then visible=1; fi
            if (( sel < top )); then top=$sel; fi
            if (( sel >= top + visible )); then top=$(( sel - visible + 1 )); fi
            if (( top > line_count - visible )); then top=$(( line_count - visible )); fi
            if (( top < 0 )); then top=0; fi
            local last=$(( top + visible ))
            if (( last > line_count )); then last=$line_count; fi

            local row rule
            printf -v row "     %-30s  %-25s  %-6s  %s" "DESCRIPTION" "ADDRESS" "REGION" "SSH"
            buf+="${t_bold}${row:0:width}${t_sgr0}${el}"$'\n'
            printf -v rule '─%.0s' {1..81}
            buf+=" ${rule:0:width - 1}${el}"$'\n'

            local i status desc addr region label color rev
            for (( i = top; i < last; i++ )); do
                IFS=$'\t' read -r status desc addr region <<< "${lines[$i]}"
                label="${labels[$i]:-}"
                color=$'\e[90m'
                if [[ "$status" == "●" ]]; then color=$'\e[32m'; fi
                rev=""
                if (( i == sel )); then rev=$'\e[7m'; fi
                printf -v row " %-30.30s  %-25s  %-6s  %s" "$desc" "$addr" "$region" "$label"
                row="${row:0:width > 4 ? width - 4 : 0}"
                buf+=" ${color}${status}  "$'\e[0m'"${rev}${row}"$'\e[0m'"${el}"$'\n'
            done

            buf+="${el}"$'\n'
            local summary=" ${line_count} address(es)"
            if (( line_count > visible )); then
                summary+="  —  showing $(( top + 1 ))-${last}"
            fi
            buf+="${t_dim}${summary:0:width}${t_sgr0}${el}"
        fi

        buf+=$'\n'"${el}"$'\n'
        # status message or help
        if [[ -n "$status_msg" ]] && (( SECONDS < status_expire )); then
            local shown=" ${status_msg}"
            buf+=$'\e[33m'"${shown:0:width}"$'\e[0m'
        else
            status_msg=""
            local help=" ↑/↓ navigate  c copy address  s copy ssh cmd  a add to ssh config  q quit"
            buf+="${t_dim}${help:0:width}${t_sgr0}"
        fi

        # home, the frame, then clear whatever is left below it
        printf '\e[H%s\e[K\e[J' "$buf"
    }

    set_status() {
        status_msg="$1"
        status_expire=$(( SECONDS + 3 ))
        needs_redraw=1
    }

    get_selected_addr() {
        if (( line_count > 0 )); then
            IFS=$'\t' read -r _ _ addr _ <<< "${lines[$sel]}"
            echo "$addr"
        fi
    }

    move_sel() {
        local target=$(( sel + $1 ))
        if (( target > line_count - 1 )); then target=$(( line_count - 1 )); fi
        if (( target < 0 )); then target=0; fi
        if (( target != sel )); then
            sel=$target
            needs_redraw=1
        fi
    }

    page_size() {
        local n=$(( term_rows - 9 ))
        if (( n < 1 )); then n=1; fi
        echo "$n"
    }

    add_to_ssh_config() {
        if (( line_count == 0 )); then return 0; fi
        local desc addr
        IFS=$'\t' read -r _ desc addr _ <<< "${lines[$sel]}"
        if [[ -z "$addr" ]]; then return 0; fi
        local host="${addr%%:*}" port="${addr##*:}"

        # suggest the alias that already points here, otherwise one made from the description
        local suggestion="${ssh_alias_by_addr[${addr,,}]:-}"
        if [[ -z "$suggestion" ]]; then
            ssh_alias_for "$desc"
            suggestion="$REPLY"
        fi

        local alias=""
        tput cup $(( term_rows - 1 )) 0
        tput el
        tput cnorm
        read -r -e -i "$suggestion" -p " Host alias (empty to cancel): " alias || alias=""
        tput civis
        needs_redraw=1

        alias="${alias//[[:space:]]/}"
        if [[ -z "$alias" ]]; then
            set_status "Cancelled"
            return 0
        fi
        if [[ ! "$alias" =~ ^[A-Za-z0-9._-]+$ ]]; then
            set_status "Invalid alias: ${alias}"
            return 0
        fi

        local result
        if result="$(ssh_config_upsert "$alias" "$host" "$port" "${ssh_user:-}" 2>/dev/null)"; then
            load_ssh_map
            refresh_labels
            set_status "ssh config ${result}: ssh ${alias}"
        else
            set_status "Could not write $(ssh_config_path)"
        fi
    }

    handle_key() {
        local key="$1"
        case "$key" in
            q|Q) exit 0 ;;
            UP|k)     move_sel -1 ;;
            DOWN|j)   move_sel 1 ;;
            PGUP)     move_sel "-$(page_size)" ;;
            PGDN)     move_sel "$(page_size)" ;;
            HOME|g)   move_sel "-${line_count}" ;;
            END|G)    move_sel "${line_count}" ;;
            a)        add_to_ssh_config ;;
            c|C)
                local addr
                addr="$(get_selected_addr)"
                if [[ -n "$addr" ]]; then
                    if clip_copy "$addr"; then
                        set_status "Copied: ${addr}"
                    else
                        set_status "No clipboard tool found (install xclip, xsel, or wl-copy)"
                    fi
                fi
                ;;
            s|S)
                local addr
                addr="$(get_selected_addr)"
                if [[ -n "$addr" ]]; then
                    local host port
                    host="${addr%%:*}"
                    port="${addr##*:}"
                    local user="${ssh_user:-}"
                    local ssh_cmd="ssh ${user:+${user}@}${host} -p ${port}"
                    if clip_copy "$ssh_cmd"; then
                        set_status "Copied: ${ssh_cmd}"
                    else
                        set_status "No clipboard tool found (install xclip, xsel, or wl-copy)"
                    fi
                fi
                ;;
        esac
    }

    # Reads the rest of an escape sequence (the \e is already consumed) and
    # prints a key name, or nothing for sequences we do not use.
    read_escape() {
        local seq="" ch=""
        while ch=""; read -rsn1 -t 0.05 ch 2>/dev/null || [[ -n "$ch" ]]; do
            seq+="$ch"
            if [[ "$seq" != "[" && "$seq" != "O" && "$ch" =~ [A-Za-z~] ]]; then break; fi
        done
        case "$seq" in
            "[A"|"OA") echo UP ;;
            "[B"|"OB") echo DOWN ;;
            "[5~") echo PGUP ;;
            "[6~") echo PGDN ;;
            "[H"|"OH"|"[1~"|"[7~") echo HOME ;;
            "[F"|"OF"|"[4~"|"[8~") echo END ;;
        esac
    }

    local lines=()
    local error=""
    local key

    start_fetch
    draw
    needs_redraw=0

    while true; do
        # on a timeout bash may still hand us a byte it had already read
        key=""
        if read -rsn1 -t 0.2 key 2>/dev/null || [[ -n "$key" ]]; then
            if [[ "$key" == $'\x1b' ]]; then
                key="$(read_escape)"
            fi
            handle_key "$key"
            # A held key queues up repeats faster than we can draw. Take
            # everything that is waiting first, then draw once.
            # (read -t 0 only tests for input, so no byte can be lost
            # to a timeout that fires in the middle of a read)
            while read -t 0 2>/dev/null; do
                read -rsn1 key 2>/dev/null || break
                if [[ "$key" == $'\x1b' ]]; then
                    key="$(read_escape)"
                fi
                handle_key "$key"
            done
        fi

        if (( fetching )); then
            collect_fetch || true
        elif (( SECONDS >= next_fetch )); then
            start_fetch
        fi
        check_for_update

        # clear expired status messages
        if [[ -n "$status_msg" ]] && (( SECONDS >= status_expire )); then
            status_msg=""
            needs_redraw=1
        fi
        if (( needs_redraw )); then
            draw
            needs_redraw=0
        fi
    done
}

# --- CLI ---

usage() {
    cat <<'EOF'
Usage: ngrok-status [command]

Commands:
  watch                  Launch the live TUI dashboard (default)
  config set <key> <val> Set a config value
  config get [key]       Show config values
  config path            Print config file path
  update                 Install the latest version over this one
  version                Print the version, and whether a newer one exists

Config keys:
  api_key                Your ngrok API key
  refresh_interval       Refresh interval in seconds (default: 5)
  ssh_user               Default SSH username for the 's' shortcut and new ssh config entries
  ssh_config             ssh config file to edit (default: ~/.ssh/config)
  alias_strip_prefix     Prefix dropped from the description when suggesting a Host alias
  check_updates          Set to false to stop the TUI from checking for new versions
EOF
}

case "${1:-watch}" in
    watch)
        watch_tui
        ;;
    config)
        case "${2:-}" in
            set)
                [[ -z "${3:-}" || -z "${4:-}" ]] && { echo "Usage: ngrok-status config set <key> <value>" >&2; exit 1; }
                config_set "$3" "$4"
                echo "$3 set."
                ;;
            get)
                config_get "${3:-}"
                ;;
            path)
                echo "$CONFIG_FILE"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    -h|--help|help)
        usage
        ;;
    -v|--version|version)
        echo "ngrok-status ${VERSION}"
        config_load
        if [[ "${check_updates:-true}" != false ]]; then
            latest="$(latest_version || true)"
            if [[ -n "$latest" ]] && version_gt "$latest" "$VERSION"; then
                echo "Version ${latest} is available. To update, run: ngrok-status update"
            fi
        fi
        ;;
    update)
        self_update
        ;;
    *)
        usage
        exit 1
        ;;
esac
