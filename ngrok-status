#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
CONFIG_DIR="${HOME}/.config/ngrok-status"
CONFIG_FILE="${CONFIG_DIR}/config"
# the ngrok API (overridable for testing)
API_BASE="${NGROK_STATUS_API_BASE:-https://api.ngrok.com}"
ADDRS_URL="${API_BASE}/reserved_addrs"
ENDPOINTS_URL="${API_BASE}/endpoints"
# where the published script and installer live (overridable for testing)
RAW_BASE="${NGROK_STATUS_RAW_BASE:-https://raw.githubusercontent.com/dritory/ngrok-status/main}"
UPDATE_CHECK_EVERY=$(( 6 * 3600 ))  # seconds between checks while the TUI runs

# --- clipboard helper ---

clip_copy() {
    local text="$1"
    if command -v wl-copy &>/dev/null; then
        printf '%s' "$text" | wl-copy
    elif command -v xclip &>/dev/null; then
        printf '%s' "$text" | xclip -selection clipboard
    elif command -v xsel &>/dev/null; then
        printf '%s' "$text" | xsel --clipboard --input
    elif command -v pbcopy &>/dev/null; then
        printf '%s' "$text" | pbcopy
    else
        return 1
    fi
}

# --- config helpers ---
#
# The config file is a list of key="value" lines. Versions before 0.4.0 ran
# the file as bash code. We now only read it, which means that a value can
# never be executed, and we keep accepting everything those versions wrote.

CONFIG_KEYS=(api_key refresh_interval ssh_user ssh_config alias_strip_prefix check_updates)
CONFIG_WARNINGS=()
CONFIG_LOADED=0

config_key_known() {
    local k
    for k in "${CONFIG_KEYS[@]}"; do
        if [[ "$k" == "$1" ]]; then return 0; fi
    done
    return 1
}

# Leaves the label, the explanation and the default of a config key in
# CFG_LABEL, CFG_HELP and CFG_DEFAULT.
config_describe() {
    CFG_LABEL="$1"; CFG_HELP=""; CFG_DEFAULT=""
    case "$1" in
        api_key)
            CFG_LABEL="API key"
            CFG_HELP="Your ngrok API key, from https://dashboard.ngrok.com/api-keys (not the agent's authtoken)." ;;
        refresh_interval)
            CFG_LABEL="Refresh interval"
            CFG_HELP="Seconds between two fetches of the address list."
            CFG_DEFAULT="5" ;;
        ssh_user)
            CFG_LABEL="SSH user"
            CFG_HELP="User name for the copied ssh command and for new ssh config entries." ;;
        ssh_config)
            CFG_LABEL="SSH config file"
            CFG_HELP="The ssh config file that 'a' edits, and that the SSH column is read from."
            # shellcheck disable=SC2088
            CFG_DEFAULT="~/.ssh/config" ;;
        alias_strip_prefix)
            CFG_LABEL="Alias prefix"
            CFG_HELP="Dropped from a description to suggest a Host alias: with bv-, bv-krikkand becomes krikkand." ;;
        check_updates)
            CFG_LABEL="Check for updates"
            CFG_HELP="Whether to look for a newer version at startup and every 6 hours (true or false)."
            CFG_DEFAULT="true" ;;
    esac
}

# Checks a value for a key. On failure the reason is left in REPLY.
config_validate() {
    local key="$1" value="$2"
    local unsafe='[$`"'"'"'\\]'
    REPLY=""
    if ! config_key_known "$key"; then
        REPLY="unknown key '${key}' (known keys: ${CONFIG_KEYS[*]})"
        return 1
    fi
    if [[ "$value" =~ [[:cntrl:]] ]]; then
        REPLY="the value must be a single line of plain text"
        return 1
    fi
    # These characters meant something when old versions ran the file as code.
    # Keeping them out means old and new versions always read the same value.
    if [[ "$value" =~ $unsafe ]]; then
        REPLY="the value cannot contain \$, backticks, quotes or backslashes"
        return 1
    fi
    case "$key" in
        api_key)
            if [[ ! "$value" =~ ^[^[:space:]]+$ ]]; then
                REPLY="the API key cannot be empty or contain spaces"; return 1
            fi ;;
        refresh_interval)
            if [[ ! "$value" =~ ^[1-9][0-9]{0,4}$ ]]; then
                REPLY="the refresh interval must be a whole number of seconds, 1 or more"; return 1
            fi ;;
        ssh_user)
            if [[ ! "$value" =~ ^[^[:space:]]+$ ]]; then
                REPLY="the SSH user cannot be empty or contain spaces"; return 1
            fi ;;
        ssh_config)
            if [[ -z "$value" ]]; then REPLY="the path cannot be empty"; return 1; fi ;;
        alias_strip_prefix)
            if [[ ! "$value" =~ ^[^[:space:]]+$ ]]; then
                REPLY="the prefix cannot be empty or contain spaces"; return 1
            fi ;;
        check_updates)
            if [[ "$value" != true && "$value" != false ]]; then
                REPLY="check_updates must be true or false"; return 1
            fi ;;
    esac
    return 0
}

# Splits one line of the config file into CFG_KEY and CFG_VALUE.
# Returns 1 for blank lines and comments, and 2 for a line that is not a
# plain setting. In the last case CFG_KEY is still set if the line names one.
#
# Old versions ran the file through bash, so a line is read the way bash
# would read a simple assignment: an unquoted value ends at the first space,
# a quoted value ends at its closing quote, and a # after that starts a
# comment. Anything bash would have had to evaluate is not a plain setting.
config_parse_line() {
    local line="$1" key value rest="" quote
    local needs_shell='[][;|&<>(){}*?!~"'"'"'\\]'
    CFG_KEY=""; CFG_VALUE=""
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    if [[ -z "$line" || "$line" == \#* ]]; then return 1; fi
    if [[ "$line" == export[[:space:]]* ]]; then
        line="${line#export}"
        line="${line#"${line%%[![:space:]]*}"}"
    fi
    if [[ "$line" != *=* ]]; then return 2; fi
    key="${line%%=*}"
    value="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then return 2; fi
    CFG_KEY="$key"
    value="${value#"${value%%[![:space:]]*}"}"

    if [[ "$value" == \"* || "$value" == \'* ]]; then
        quote="${value:0:1}"
        value="${value:1}"
        if [[ "$value" != *"$quote"* ]]; then return 2; fi  # never closed
        rest="${value#*"$quote"}"
        value="${value%%"$quote"*}"
        # inside double quotes bash would expand these
        if [[ "$quote" == '"' && "$value" == *[\\\$\`]* ]]; then return 2; fi
    else
        rest="${value#"${value%%[[:space:]]*}"}"
        value="${value%%[[:space:]]*}"
        # a leading ~/ is the one thing we expand ourselves (see ssh_config_path)
        local probe="$value"
        # shellcheck disable=SC2088
        if [[ "$probe" == "~/"* ]]; then probe="${probe:1}"; fi
        if [[ "$probe" == *[\$\`]* || "$probe" =~ $needs_shell ]]; then return 2; fi
    fi

    # what follows the value must be nothing, or a comment set off by a space
    if [[ -n "$rest" && "$rest" != [[:space:]]* ]]; then return 2; fi
    rest="${rest#"${rest%%[![:space:]]*}"}"
    if [[ -n "$rest" && "$rest" != \#* ]]; then return 2; fi
    CFG_VALUE="$value"
    return 0
}

# Reads the config file into the variables named after the keys. Problems are
# collected in CONFIG_WARNINGS instead of printed, since the TUI may be up.
config_load() {
    if (( CONFIG_LOADED )); then return 0; fi
    CONFIG_LOADED=1
    CONFIG_WARNINGS=()

    if [[ -f "$CONFIG_FILE" ]]; then
        # The file holds the API key. Versions before 0.4.0 created it readable
        # by everyone on the machine, so we tighten it whenever we see it.
        if [[ -O "$CONFIG_FILE" ]]; then
            chmod 600 "$CONFIG_FILE" 2>/dev/null || true
        fi

        local line n=0 rc
        while IFS= read -r line || [[ -n "$line" ]]; do
            (( n++ )) || true
            rc=0
            config_parse_line "$line" || rc=$?
            if (( rc == 1 )); then continue; fi
            if (( rc == 2 )) && [[ -z "$CFG_KEY" ]]; then
                CONFIG_WARNINGS+=("line ${n} of the config file is not a key=value setting, so it is ignored")
                continue
            fi
            if ! config_key_known "$CFG_KEY"; then
                CONFIG_WARNINGS+=("line ${n} of the config file sets the unknown key '${CFG_KEY}', so it is ignored")
                continue
            fi
            if (( rc == 2 )); then
                CONFIG_WARNINGS+=("${CFG_KEY} (line ${n} of the config file) looks like shell code, which is no longer run, so it is ignored. Set it again with: ngrok-status config set ${CFG_KEY} <value>")
                continue
            fi
            printf -v "$CFG_KEY" '%s' "$CFG_VALUE"
        done < "$CONFIG_FILE"
    fi

    # values that also arrive through the environment get the same checks
    if [[ -n "${refresh_interval:-}" ]] && ! config_validate refresh_interval "$refresh_interval"; then
        CONFIG_WARNINGS+=("refresh_interval is '${refresh_interval}', which is not a number of seconds. Using 5.")
        refresh_interval=5
    fi
    if [[ -n "${check_updates:-}" ]] && ! config_validate check_updates "$check_updates"; then
        CONFIG_WARNINGS+=("check_updates is '${check_updates}', but it must be true or false. Using true.")
        check_updates=true
    fi
    return 0
}

config_print_warnings() {
    local w
    for w in "${CONFIG_WARNINGS[@]}"; do
        echo "Warning: ${w}" >&2
    done
}

# Sets one key in the config file, or removes it when the value is empty.
# Every other line is kept as it is. The new file is written next to the old
# one and then renamed over it, so a crash never leaves half a config behind.
config_write() {
    local key="$1" value="${2-}"
    local target="$CONFIG_FILE" dir tmp line rc written=0

    mkdir -p "$CONFIG_DIR" || return 1
    if [[ -L "$target" ]]; then
        # keep a symlinked config (dotfiles) a symlink: replace what it points at
        local link
        if ! link="$(readlink -f "$target" 2>/dev/null)"; then
            # readlink without -f (older macOS) gives the link text as it is
            link="$(readlink "$target")" || return 1
            if [[ "$link" != /* ]]; then link="$(dirname "$target")/${link}"; fi
        fi
        target="$link"
    fi
    dir="$(dirname "$target")"
    tmp="$(umask 077; mktemp "${dir}/.config.XXXXXX")" || return 1

    {
        if [[ -f "$target" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                rc=0
                config_parse_line "$line" || rc=$?
                if (( rc != 1 )) && [[ "$CFG_KEY" == "$key" ]]; then
                    # the first occurrence is replaced, repeats are dropped
                    if (( ! written )) && [[ -n "$value" ]]; then
                        printf '%s="%s"\n' "$key" "$value"
                    fi
                    written=1
                    continue
                fi
                printf '%s\n' "$line"
            done < "$target"
        fi
        if (( ! written )) && [[ -n "$value" ]]; then
            printf '%s="%s"\n' "$key" "$value"
        fi
    } > "$tmp" || { rm -f "$tmp"; return 1; }

    chmod 600 "$tmp" && mv "$tmp" "$target" || { rm -f "$tmp"; return 1; }
}

# Tidies a value before it is checked and saved. The result is left in REPLY.
config_normalize() {
    local key="$1" value="$2"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    # Versions before 0.4.0 do not expand ~ in this path, so the full path is
    # what goes into the file. That way every version reads the same thing.
    # shellcheck disable=SC2088
    if [[ "$key" == ssh_config && ( "$value" == "~" || "$value" == "~/"* ) ]]; then
        value="${HOME}${value:1}"
    fi
    REPLY="$value"
}

# "abcd***wxyz", so that a key can be recognised without being shown
mask_secret() {
    local v="$1"
    if (( ${#v} > 8 )); then
        REPLY="${v:0:4}***${v: -4}"
    else
        REPLY="***"
    fi
}

config_set() {
    local key="$1" value="$2"
    config_normalize "$key" "$value"
    value="$REPLY"
    if ! config_validate "$key" "$value"; then
        echo "Error: ${REPLY}" >&2
        return 1
    fi
    if ! config_write "$key" "$value"; then
        echo "Error: could not write ${CONFIG_FILE}" >&2
        return 1
    fi
    echo "${key} set."
}

config_unset() {
    local key="$1"
    if ! config_key_known "$key"; then
        echo "Error: unknown key '${key}' (known keys: ${CONFIG_KEYS[*]})" >&2
        return 1
    fi
    if [[ -f "$CONFIG_FILE" ]] && ! config_write "$key" ""; then
        echo "Error: could not write ${CONFIG_FILE}" >&2
        return 1
    fi
    echo "${key} unset."
}

config_show_key() {
    local key="$1" val="${!1:-}"
    config_describe "$key"
    if [[ -z "$val" ]]; then
        if [[ -n "$CFG_DEFAULT" ]]; then
            echo "${key} = ${CFG_DEFAULT} (default)"
        else
            echo "${key} = <unset>"
        fi
    elif [[ "$key" == api_key ]]; then
        mask_secret "$val"
        echo "${key} = ${REPLY}"
    else
        echo "${key} = ${val}"
    fi
}

config_get() {
    local key="${1:-}" k
    config_load
    config_print_warnings
    if [[ -z "$key" ]]; then
        for k in "${CONFIG_KEYS[@]}"; do
            config_show_key "$k"
        done
    elif config_key_known "$key"; then
        config_show_key "$key"
    else
        echo "Error: unknown key '${key}' (known keys: ${CONFIG_KEYS[*]})" >&2
        return 1
    fi
}

# --- ngrok API helpers ---

# curl against the ngrok API. The key goes in through stdin instead of the
# command line, where every user on the machine could read it with ps.
ngrok_curl() {
    local key="$1" url="$2"
    printf 'header = "Authorization: Bearer %s"\n' "$key" \
        | curl -s --max-time 10 -K - -H "ngrok-version: 2" -w '\n%{http_code}' "$url"
}

# Tries an API key. Returns 0 when ngrok accepts it (the response is left in
# API_BODY), 1 when ngrok rejects it and 2 when ngrok cannot be reached. In
# the last two cases REPLY says why.
api_check_key() {
    local key="$1" out code detail
    API_BODY=""
    out="$(ngrok_curl "$key" "$ADDRS_URL" 2>/dev/null)" || true
    code="${out##*$'\n'}"
    API_BODY="${out%$'\n'*}"
    if [[ "$code" == 200 ]]; then return 0; fi
    if [[ -z "$code" || "$code" == 000 ]]; then
        REPLY="could not reach the ngrok API"
        return 2
    fi
    detail="$(jq -r '.msg // .message // empty' <<< "$API_BODY" 2>/dev/null | head -n 1 || true)"
    detail="${detail%.}"
    REPLY="ngrok did not accept the key (HTTP ${code})${detail:+: ${detail}}"
    return 1
}

# Looks for a prefix such as "bv-" that most descriptions share, to offer it
# as alias_strip_prefix. Reads an API response from $1, answers in REPLY.
suggest_alias_prefix() {
    local body="$1" desc prefix total=0 best="" best_count=0
    local -A count=()
    REPLY=""
    while IFS= read -r desc; do
        (( total++ )) || true
        if [[ "$desc" =~ ^([A-Za-z0-9]+-) ]]; then
            prefix="${BASH_REMATCH[1]}"
            count[$prefix]=$(( ${count[$prefix]:-0} + 1 ))
            if (( count[$prefix] > best_count )); then
                best="$prefix"; best_count=${count[$prefix]}
            fi
        fi
    done < <(jq -r '.reserved_addrs[]?.description // empty' <<< "$body" 2>/dev/null || true)
    if (( total >= 3 && best_count * 2 > total )); then
        REPLY="$best"
    fi
}

# --- setup ---

# Asks for one optional setting until the answer is valid, and saves it.
# An empty answer removes the setting.
setup_ask() {
    local key="$1" prompt="$2" suggestion="$3" answer
    while true; do
        answer=""
        read -r -e -i "$suggestion" -p "  ${prompt}: " answer || { echo; return 0; }
        answer="${answer#"${answer%%[![:space:]]*}"}"
        answer="${answer%"${answer##*[![:space:]]}"}"
        if [[ -z "$answer" ]]; then
            if [[ -n "${!key:-}" ]]; then
                config_write "$key" "" || echo "  Could not write ${CONFIG_FILE}"
                unset "$key"
            fi
            return 0
        fi
        if config_validate "$key" "$answer"; then
            if config_write "$key" "$answer"; then
                printf -v "$key" '%s' "$answer"
            else
                echo "  Could not write ${CONFIG_FILE}"
            fi
            return 0
        fi
        echo "  That does not work: ${REPLY}."
    done
}

# The first-run screen, also reachable as `ngrok-status setup`. It gets a
# working API key into the config file and offers the two ssh settings.
run_setup() {
    local first_run="${1:-0}" current key answer rc prefix keeping w
    config_load
    current="${api_key:-}"

    if [[ -t 1 ]]; then tput clear 2>/dev/null || true; fi
    echo
    echo "  ngrok-status setup"
    echo
    echo "  This tool lists your reserved ngrok TCP addresses and shows which of them"
    echo "  are online. To do that it needs an ngrok API key, which you create at"
    echo
    echo "      https://dashboard.ngrok.com/api-keys"
    echo
    echo "  Note that an API key is not the authtoken that the ngrok agent uses."
    echo "  What you paste is not shown on screen."
    echo
    if (( ${#CONFIG_WARNINGS[@]} )); then
        # Without this, someone whose api_key line was shell code would land
        # here with no idea why the tool forgot their key.
        echo "  Your config file has lines that this version does not use:"
        for w in "${CONFIG_WARNINGS[@]}"; do
            echo "    - ${w}" | fold -s -w 76 | sed '2,$s/^/      /'
        done
        echo "  If your API key comes from a command, quit here and put it in the"
        echo "  NGROK_API_KEY environment variable. A key that you enter below is"
        echo "  written to the config file as plain text, in place of that line."
        echo
    fi

    while true; do
        key=""
        keeping=0
        rc=0
        if [[ -n "$current" ]]; then
            mask_secret "$current"
            read -r -s -p "  API key (Enter keeps ${REPLY}): " key || rc=$?
        else
            read -r -s -p "  API key (Enter to quit): " key || rc=$?
        fi
        echo
        if (( rc != 0 )); then
            # end of input (Ctrl-D): there is nobody left to ask
            echo
            echo "  Setup cancelled. Nothing was saved."
            return 1
        fi
        key="${key//[[:space:]]/}"

        if [[ -z "$key" ]]; then
            if [[ -n "$current" ]]; then
                key="$current"
                keeping=1
            else
                echo
                echo "  Setup cancelled. Nothing was saved."
                return 1
            fi
        fi
        if ! config_validate api_key "$key"; then
            echo "  That does not work: ${REPLY}."
            echo
            continue
        fi

        printf '  Checking the key with ngrok…'
        rc=0
        api_check_key "$key" || rc=$?
        printf '\r\e[K'
        if (( rc == 0 )); then
            local found
            found="$(jq -r '.reserved_addrs | length' <<< "$API_BODY" 2>/dev/null || echo 0)"
            echo "  The key works: ngrok reports ${found} reserved address(es)."
            break
        fi
        echo "  That did not work: ${REPLY}."
        if (( keeping )); then
            # the key was already there, so there is nothing to refuse to save
            echo "  The current key is kept. Run setup again to replace it."
            break
        fi
        if (( rc == 2 )); then
            answer=""
            read -r -p "  Save the key anyway, without checking it? [y/N] " answer || answer=""
            if [[ "$answer" == [yY]* ]]; then break; fi
        fi
        echo
    done

    if ! config_write api_key "$key"; then
        echo "  Error: could not write ${CONFIG_FILE}" >&2
        return 1
    fi
    api_key="$key"

    echo
    echo "  The next two settings are optional, and you can change them later by"
    echo "  pressing e in the tool. Press Enter to accept what is shown, or clear"
    echo "  the line to leave a setting empty."
    echo
    echo "  The SSH user is put in the ssh command you copy with s, and in entries"
    echo "  that you add to your ssh config with a."
    setup_ask ssh_user "SSH user" "${ssh_user:-}"
    echo
    prefix="${alias_strip_prefix:-}"
    if [[ -z "$prefix" ]]; then
        suggest_alias_prefix "$API_BODY"
        prefix="$REPLY"
    fi
    echo "  The alias prefix is dropped from a description when the tool suggests a"
    echo "  name for your ssh config."
    if [[ -n "$prefix" ]]; then
        echo "  With ${prefix}, an address called ${prefix}example gets the alias example."
    fi
    setup_ask alias_strip_prefix "Alias prefix to drop" "$prefix"

    # the file has changed, so what was reported about it may no longer hold
    CONFIG_LOADED=0
    config_load

    echo
    echo "  Saved to ${CONFIG_FILE}"
    if (( first_run )); then
        echo
        read -r -s -p "  Press Enter to start. " answer || true
        echo
    fi
    return 0
}

# --- update helpers ---

# Prints the version of the published script, or nothing if it cannot be reached.
latest_version() {
    curl -fsSL --max-time 5 "${RAW_BASE}/ngrok-status" 2>/dev/null \
        | sed -n 's/^VERSION="\([0-9][0-9A-Za-z.-]*\)"$/\1/p' | head -n 1
}

# True when version $1 is newer than version $2.
version_gt() {
    [[ "$1" != "$2" ]] || return 1
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]
}

self_update() {
    local installer
    installer="$(mktemp)"
    if ! curl -fsSL --max-time 30 "${RAW_BASE}/install.sh" -o "$installer"; then
        rm -f "$installer"
        echo "Error: could not download the installer from ${RAW_BASE}/install.sh" >&2
        exit 1
    fi
    local rc=0
    bash "$installer" || rc=$?
    rm -f "$installer"
    exit "$rc"
}

# --- ssh config helpers ---

ssh_config_path() {
    local path="${ssh_config:-${HOME}/.ssh/config}"
    # a path typed into the file by hand may start with ~, which no shell expands for us
    # shellcheck disable=SC2088
    if [[ "$path" == "~" || "$path" == "~/"* ]]; then
        path="${HOME}${path:1}"
    fi
    echo "$path"
}

# "bv-Krikkand 2" -> "krikkand-2" (with alias_strip_prefix="bv-").
# The result is left in REPLY, which saves a subshell per row.
ssh_alias_for() {
    local name="$1" prefix="${alias_strip_prefix:-}"
    if [[ -n "$prefix" ]]; then
        name="${name#"$prefix"}"
    fi
    name="${name,,}"
    name="${name//[^a-z0-9._-]/-}"
    while [[ "$name" == *--* ]]; do name="${name//--/-}"; done
    name="${name#-}"
    name="${name%-}"
    REPLY="$name"
}

# Prints "alias<TAB>host:port" for every Host block in the ssh config.
ssh_config_list() {
    local file
    file="$(ssh_config_path)"
    [[ -f "$file" ]] || return 0
    awk '
        function flush() {
            if (alias != "" && host != "") print alias "\t" tolower(host) ":" port
            alias = ""; host = ""; port = 22
        }
        {
            key = tolower($1); sub(/=.*/, "", key)
            if (key == "host" || key == "match") {
                flush()
                if (key == "host" && $2 !~ /[*?!]/) alias = $2
                next
            }
            if (key == "hostname") host = $2
            if (key == "port") port = $2
        }
        END { flush() }
    ' "$file"
}

# Points Host <alias> at host:port. An existing block keeps everything except
# HostName and Port; otherwise a new block is appended. Prints "updated" or "added".
ssh_config_upsert() {
    local alias="$1" host="$2" port="$3" user="${4:-}"
    local file tmp rc=0
    file="$(ssh_config_path)"

    if [[ ! -e "$file" ]]; then
        mkdir -p "$(dirname "$file")"
        ( umask 077; : > "$file" )
    fi

    tmp="$(mktemp)"
    awk -v alias="$alias" -v host="$host" -v port="$port" -v user="$user" '
        function flush_block() {
            if (!in_target) return
            if (!seen_host) print indent "HostName " host
            if (!seen_port) print indent "Port " port
            printf "%s", pending
            pending = ""
            in_target = 0
        }
        {
            last_blank = ($0 ~ /^[ \t]*$/)
            key = tolower($1); sub(/=.*/, "", key)
            if (key == "host" || key == "match") {
                flush_block()
                if (key == "host") {
                    for (i = 2; i <= NF; i++) if ($i == alias) in_target = 1
                    if (in_target) {
                        found = 1; seen_host = 0; seen_port = 0
                        indent = "    "; have_indent = 0
                    }
                }
                print; next
            }
            if (!in_target) { print; next }
            # hold back blank lines so that inserted options land above them
            if (last_blank) { pending = pending $0 "\n"; next }
            printf "%s", pending; pending = ""
            match($0, /^[ \t]*/); cur = substr($0, 1, RLENGTH)
            if (!have_indent) { indent = cur; have_indent = 1 }
            if (key == "hostname") {
                if (!seen_host) print cur "HostName " host
                seen_host = 1; next
            }
            if (key == "port") {
                if (!seen_port) print cur "Port " port
                seen_port = 1; next
            }
            print
        }
        END {
            flush_block()
            if (!found) {
                if (NR > 0 && !last_blank) print ""
                print "Host " alias
                print "    HostName " host
                print "    Port " port
                if (user != "") print "    User " user
            }
            exit(found ? 0 : 3)
        }
    ' "$file" > "$tmp" || rc=$?

    if (( rc != 0 && rc != 3 )); then
        rm -f "$tmp"
        return 1
    fi

    cp -p "$file" "${file}.ngrok-status.bak"
    # write through the existing file so that permissions and symlinks survive
    cat "$tmp" > "$file"
    rm -f "$tmp"
    if (( rc == 3 )); then echo "added"; else echo "updated"; fi
}

# --- watch TUI ---

watch_tui() {
    for cmd in curl jq tput; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "Error: $cmd is required. Install it and try again." >&2
            exit 1
        fi
    done

    config_load
    local token="${NGROK_API_KEY:-${api_key:-}}"
    if [[ -z "$token" ]]; then
        if [[ -t 0 && -t 1 ]]; then
            run_setup 1 || exit 1
            token="${api_key:-}"
        else
            config_print_warnings
            echo "Error: ngrok API key not configured." >&2
            echo "Run:  ngrok-status setup" >&2
            exit 1
        fi
    fi
    local interval="${refresh_interval:-5}"

    local t_rev t_bold t_dim t_sgr0
    t_rev="$(tput rev)"; t_bold="$(tput bold)"; t_dim="$(tput dim)"; t_sgr0="$(tput sgr0)"
    local el=$'\e[K'

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local result_file="${tmp_dir}/result"
    local fetching=0 fetch_pid="" next_fetch=0 loaded=0
    local update_file="${tmp_dir}/latest"
    local update_pid="" next_update_check=0 update_notice=""

    cleanup() {
        if [[ -n "$fetch_pid" ]]; then kill "$fetch_pid" 2>/dev/null || true; fi
        if [[ -n "$update_pid" ]]; then kill "$update_pid" 2>/dev/null || true; fi
        rm -rf "$tmp_dir"
        tput cnorm; tput sgr0; echo
    }
    trap cleanup EXIT
    trap 'exit 0' INT TERM
    trap 'resized=1; needs_redraw=1' WINCH

    tput civis  # hide cursor
    tput clear

    local mode=list  # "list" shows the addresses, "settings" the config
    local settings_sel=0
    local sel=0
    local top=0  # index of the first row shown
    local line_count=0
    local status_msg=""
    local status_expire=0
    local needs_redraw=1
    # draw runs on every keypress, so it must not fork: everything it needs
    # (terminal size, timestamp, SSH labels) is worked out ahead of time
    local resized=1
    local term_rows=24 term_cols=80
    local refreshed_at=""
    local labels=()
    local -A ssh_alias_by_addr=()
    local -A ssh_addr_by_alias=()

    load_ssh_map() {
        ssh_alias_by_addr=()
        ssh_addr_by_alias=()
        local a t
        while IFS=$'\t' read -r a t; do
            [[ -z "$a" ]] && continue
            # ssh uses the first block that matches, so we do the same
            [[ -z "${ssh_addr_by_alias[$a]:-}" ]] && ssh_addr_by_alias[$a]="$t"
            [[ -z "${ssh_alias_by_addr[$t]:-}" ]] && ssh_alias_by_addr[$t]="$a"
        done < <(ssh_config_list 2>/dev/null || true)
        return 0
    }

    # Talks to the ngrok API and writes the outcome to $1: a first line of
    # "ok" or "error<TAB>message", followed by one TSV line per address.
    # This runs in the background, so it must not touch the TUI state.
    fetch_to_file() {
        local out="$1" addrs endpoints http_code

        # the two requests are independent, so they run side by side
        ngrok_curl "$token" "$ADDRS_URL" > "${out}.addrs" 2>&1 &
        ngrok_curl "$token" "$ENDPOINTS_URL" > "${out}.endpoints" 2>&1 &
        wait

        addrs="$(< "${out}.addrs")"
        http_code="${addrs##*$'\n'}"
        addrs="${addrs%$'\n'*}"

        if [[ "$http_code" != 200 ]]; then
            local detail
            detail="$(jq -r '.msg // .message // empty' <<< "$addrs" 2>/dev/null || true)"
            printf 'error\tAPI request failed (HTTP %s)%s\n' "$http_code" "${detail:+: ${detail}}" > "${out}.tmp"
            mv "${out}.tmp" "$out"
            return 0
        fi

        endpoints="$(< "${out}.endpoints")"
        http_code="${endpoints##*$'\n'}"
        endpoints="${endpoints%$'\n'*}"

        # build list of connected reserved addr IDs
        local connected_ids=""
        if [[ "$http_code" == 200 ]]; then
            connected_ids="$(jq -r '
                [.endpoints[] | .tcp_addr.id // empty] | unique | join("\n")
            ' <<< "$endpoints" 2>/dev/null || true)"
        fi

        {
            echo "ok"
            jq -r --arg ids "$connected_ids" '
                ($ids | split("\n")) as $connected |
                .reserved_addrs[] |
                (.id // "") as $id |
                (if ($connected | index($id)) then "●" else "○" end) as $status |
                [$status, .description // "—", .addr // "", .region // ""] | @tsv
            ' <<< "$addrs"
        } > "${out}.tmp" 2>/dev/null || printf 'error\tCould not parse the API response\n' > "${out}.tmp"
        # the rename is atomic, so the TUI never sees a half-written result
        mv "${out}.tmp" "$out"
    }

    # A fetch takes about a second, or up to ten when the network is bad. So it
    # runs in the background, and the key loop picks the result up when it is there.
    start_fetch() {
        if (( fetching )); then return 0; fi
        fetching=1
        rm -f "$result_file"
        ( trap - EXIT; fetch_to_file "$result_file" ) < /dev/null > /dev/null 2>&1 &
        fetch_pid=$!
    }

    # Loads a finished fetch into the TUI state. Returns 1 when there is none yet.
    collect_fetch() {
        if (( ! fetching )); then return 1; fi
        if [[ ! -f "$result_file" ]]; then
            # the fetch died without leaving a result: give up on it and retry later
            if kill -0 "$fetch_pid" 2>/dev/null; then return 1; fi
            if [[ ! -f "$result_file" ]]; then
                wait "$fetch_pid" 2>/dev/null || true
                fetching=0
                next_fetch=$(( SECONDS + interval ))
                error="Fetching from the ngrok API failed"
                needs_redraw=1
                return 0
            fi
        fi

        local raw=()
        mapfile -t raw < "$result_file"
        rm -f "$result_file"
        wait "$fetch_pid" 2>/dev/null || true
        fetching=0
        next_fetch=$(( SECONDS + interval ))
        loaded=1

        if [[ "${raw[0]:-}" == ok ]]; then
            error=""
            lines=("${raw[@]:1}")
        else
            # keep showing nothing rather than a list we know is out of date
            error="${raw[0]#error$'\t'}"
            error="${error:-Fetching from the ngrok API failed}"
            lines=()
        fi

        line_count=${#lines[@]}
        if (( sel >= line_count )); then
            sel=$(( line_count > 0 ? line_count - 1 : 0 ))
        fi
        printf -v refreshed_at '%(%H:%M:%S)T' -1
        load_ssh_map
        refresh_labels
        needs_redraw=1
        return 0
    }

    # Looks up the published version in the background, like the fetch above,
    # so that a slow or missing network never holds up the TUI.
    check_for_update() {
        if [[ "${check_updates:-true}" == false ]]; then return 0; fi
        if [[ -n "$update_pid" ]]; then
            if [[ ! -f "$update_file" ]]; then
                if kill -0 "$update_pid" 2>/dev/null; then return 0; fi
                if [[ ! -f "$update_file" ]]; then
                    wait "$update_pid" 2>/dev/null || true
                    update_pid=""
                    return 0
                fi
            fi
            local latest=""
            read -r latest < "$update_file" || true
            rm -f "$update_file"
            wait "$update_pid" 2>/dev/null || true
            update_pid=""
            if [[ -n "$latest" ]] && version_gt "$latest" "$VERSION"; then
                update_notice="Version ${latest} is available (you have ${VERSION}). To update, quit and run: ngrok-status update"
                needs_redraw=1
            fi
        elif (( SECONDS >= next_update_check )); then
            next_update_check=$(( SECONDS + UPDATE_CHECK_EVERY ))
            (
                trap - EXIT
                latest_version > "${update_file}.tmp" || true
                mv "${update_file}.tmp" "$update_file"
            ) < /dev/null > /dev/null 2>&1 &
            update_pid=$!
        fi
    }

    refresh_labels() {
        labels=()
        local i desc addr
        for (( i = 0; i < ${#lines[@]}; i++ )); do
            IFS=$'\t' read -r _ desc addr _ <<< "${lines[$i]}"
            ssh_label_for "$desc" "$addr"
            labels[i]="$REPLY"
        done
    }

    # What the SSH column shows: the alias that points at this address, or the
    # expected alias marked as stale when it points somewhere else.
    ssh_label_for() {
        local desc="$1" addr="$2" alias
        REPLY="${ssh_alias_by_addr[${addr,,}]:-}"
        if [[ -n "$REPLY" ]]; then return 0; fi
        ssh_alias_for "$desc"
        alias="$REPLY"
        REPLY=""
        if [[ -n "$alias" && -n "${ssh_addr_by_alias[$alias]:-}" ]]; then
            REPLY="${alias} (stale)"
        fi
    }

    # The reverse-video bar at the top, padded to the full width. printf pads
    # by bytes, which comes out short when the text has a — in it, so the
    # padding is counted in characters here.
    header_bar() {
        local text="$1" cols="$2" pad=""
        if (( ${#text} < cols )); then
            printf -v pad '%*s' $(( cols - ${#text} )) ''
        fi
        text+="$pad"
        REPLY="${t_rev}${t_bold}${text:0:cols}${t_sgr0}"
    }

    # The last line of either screen: a status message while there is one,
    # otherwise the key help that was passed in.
    footer_line() {
        local help="$1" width="$2"
        if [[ -n "$status_msg" ]] && (( SECONDS < status_expire )); then
            local shown=" ${status_msg}"
            REPLY=$'\e[33m'"${shown:0:width}"$'\e[0m'
        else
            status_msg=""
            REPLY="${t_dim}${help:0:width}${t_sgr0}"
        fi
    }

    draw_settings() {
        local buf="" cols=$term_cols
        local width=$(( cols - 1 ))
        local header=" ngrok-status ${VERSION} settings  —  ${CONFIG_FILE} "
        header_bar "$header" "$cols"
        buf+="${REPLY}"$'\n'"${el}"$'\n'

        local i key val shown row rev
        for (( i = 0; i < ${#CONFIG_KEYS[@]}; i++ )); do
            key="${CONFIG_KEYS[$i]}"
            val="${!key:-}"
            config_describe "$key"
            if [[ -z "$val" ]]; then
                shown="—"
                if [[ -n "$CFG_DEFAULT" ]]; then shown="${CFG_DEFAULT}  (default)"; fi
            elif [[ "$key" == api_key ]]; then
                mask_secret "$val"
                shown="$REPLY"
            else
                shown="$val"
            fi
            if [[ "$key" == api_key && -n "${NGROK_API_KEY:-}" ]]; then
                shown+="  (NGROK_API_KEY from the environment is used instead)"
            fi
            printf -v row "  %-20s %s " "$CFG_LABEL" "$shown"
            rev=""
            if (( i == settings_sel )); then rev=$'\e[7m'; fi
            buf+="${rev}${row:0:width}"$'\e[0m'"${el}"$'\n'
        done

        config_describe "${CONFIG_KEYS[$settings_sel]}"
        row="  ${CFG_HELP}"
        buf+="${el}"$'\n'"${t_dim}${row:0:width}${t_sgr0}${el}"$'\n'"${el}"$'\n'
        footer_line " ↑/↓ navigate  Enter change  Esc back to the list" "$width"
        buf+="$REPLY"
        printf '\e[H%s\e[K\e[J' "$buf"
    }

    draw() {
        local buf=""
        if (( resized )); then
            term_cols="$(tput cols)"
            term_rows="$(tput lines)"
            resized=0
        fi
        if [[ "$mode" == settings ]]; then
            draw_settings
            return 0
        fi
        local cols=$term_cols rows=$term_rows
        local header=" ngrok TCP Addresses  —  refreshed ${refreshed_at}  —  every ${interval}s "
        if [[ -z "$refreshed_at" ]]; then
            header=" ngrok TCP Addresses  —  every ${interval}s "
        fi
        # every line is cut to the terminal width, because a wrapped line
        # would throw off the row count that scrolling depends on
        local width=$(( cols - 1 ))

        header_bar "$header" "$cols"
        buf+="${REPLY}"$'\n'

        # the line under the header is normally blank; it carries the update notice
        if [[ -n "$update_notice" ]]; then
            local notice=" ${update_notice}"
            buf+=$'\e[33m'"${notice:0:width}"$'\e[0m'
        fi
        buf+="${el}"$'\n'

        if (( ! loaded )) && [[ -z "$error" ]]; then
            buf+="  Loading…${el}"
        elif [[ -n "$error" ]]; then
            local msg="  ${error}"
            buf+="${msg:0:width}${el}"
        elif [[ ${#lines[@]} -eq 0 ]]; then
            buf+="  No TCP addresses found.${el}"
        else
            # 8 lines of the screen are taken up by the header and the footer
            local visible=$(( rows - 8 ))
            if (( visible < 1 )); then visible=1; fi
            if (( sel < top )); then top=$sel; fi
            if (( sel >= top + visible )); then top=$(( sel - visible + 1 )); fi
            if (( top > line_count - visible )); then top=$(( line_count - visible )); fi
            if (( top < 0 )); then top=0; fi
            local last=$(( top + visible ))
            if (( last > line_count )); then last=$line_count; fi

            local row rule
            printf -v row "     %-30s  %-25s  %-6s  %s" "DESCRIPTION" "ADDRESS" "REGION" "SSH"
            buf+="${t_bold}${row:0:width}${t_sgr0}${el}"$'\n'
            printf -v rule '─%.0s' {1..81}
            buf+=" ${rule:0:width - 1}${el}"$'\n'

            local i status desc addr region label color rev
            for (( i = top; i < last; i++ )); do
                IFS=$'\t' read -r status desc addr region <<< "${lines[$i]}"
                label="${labels[$i]:-}"
                color=$'\e[90m'
                if [[ "$status" == "●" ]]; then color=$'\e[32m'; fi
                rev=""
                if (( i == sel )); then rev=$'\e[7m'; fi
                printf -v row " %-30.30s  %-25s  %-6s  %s" "$desc" "$addr" "$region" "$label"
                row="${row:0:width > 4 ? width - 4 : 0}"
                buf+=" ${color}${status}  "$'\e[0m'"${rev}${row}"$'\e[0m'"${el}"$'\n'
            done

            buf+="${el}"$'\n'
            local summary=" ${line_count} address(es)"
            if (( line_count > visible )); then
                summary+="  —  showing $(( top + 1 ))-${last}"
            fi
            buf+="${t_dim}${summary:0:width}${t_sgr0}${el}"
        fi

        buf+=$'\n'"${el}"$'\n'
        footer_line " ↑/↓ navigate  c copy address  s copy ssh cmd  a add to ssh config  e settings  q quit" "$width"
        buf+="$REPLY"

        # home, the frame, then clear whatever is left below it
        printf '\e[H%s\e[K\e[J' "$buf"
    }

    set_status() {
        status_msg="$1"
        status_expire=$(( SECONDS + ${2:-3} ))
        needs_redraw=1
    }

    get_selected_addr() {
        if (( line_count > 0 )); then
            IFS=$'\t' read -r _ _ addr _ <<< "${lines[$sel]}"
            echo "$addr"
        fi
    }

    move_sel() {
        local target=$(( sel + $1 ))
        if (( target > line_count - 1 )); then target=$(( line_count - 1 )); fi
        if (( target < 0 )); then target=0; fi
        if (( target != sel )); then
            sel=$target
            needs_redraw=1
        fi
    }

    page_size() {
        local n=$(( term_rows - 9 ))
        if (( n < 1 )); then n=1; fi
        echo "$n"
    }

    add_to_ssh_config() {
        if (( line_count == 0 )); then return 0; fi
        local desc addr
        IFS=$'\t' read -r _ desc addr _ <<< "${lines[$sel]}"
        if [[ -z "$addr" ]]; then return 0; fi
        local host="${addr%%:*}" port="${addr##*:}"

        # suggest the alias that already points here, otherwise one made from the description
        local suggestion="${ssh_alias_by_addr[${addr,,}]:-}"
        if [[ -z "$suggestion" ]]; then
            ssh_alias_for "$desc"
            suggestion="$REPLY"
        fi

        local alias=""
        tput cup $(( term_rows - 1 )) 0
        tput el
        tput cnorm
        read -r -e -i "$suggestion" -p " Host alias (empty to cancel): " alias || alias=""
        tput civis
        needs_redraw=1

        alias="${alias//[[:space:]]/}"
        if [[ -z "$alias" ]]; then
            set_status "Cancelled"
            return 0
        fi
        if [[ ! "$alias" =~ ^[A-Za-z0-9._-]+$ ]]; then
            set_status "Invalid alias: ${alias}"
            return 0
        fi

        local result
        if result="$(ssh_config_upsert "$alias" "$host" "$port" "${ssh_user:-}" 2>/dev/null)"; then
            load_ssh_map
            refresh_labels
            set_status "ssh config ${result}: ssh ${alias}"
        else
            set_status "Could not write $(ssh_config_path)"
        fi
    }

    # Drops a fetch that is under way, so that the next one starts at once.
    # Its result would be for the old key, and collecting it would also push
    # the next fetch a whole interval into the future.
    restart_fetch() {
        if (( fetching )); then
            kill "$fetch_pid" 2>/dev/null || true
            wait "$fetch_pid" 2>/dev/null || true
            fetching=0
        fi
        rm -f "$result_file"
        next_fetch=0
    }

    # Makes a changed setting take effect in the running TUI.
    apply_setting() {
        case "$1" in
            api_key)
                token="${NGROK_API_KEY:-${api_key:-}}"
                restart_fetch ;;
            refresh_interval)
                interval="${refresh_interval:-5}"
                restart_fetch ;;
            ssh_config|alias_strip_prefix)
                load_ssh_map
                refresh_labels ;;
            check_updates)
                if [[ "${check_updates:-true}" == false ]]; then
                    update_notice=""
                else
                    next_update_check=0
                fi ;;
        esac
        needs_redraw=1
    }

    # Saves a setting and applies it. An empty value puts the default back.
    save_setting() {
        local key="$1" value="$2"
        if ! config_write "$key" "$value"; then
            set_status "Could not write ${CONFIG_FILE}" 6
            return 0
        fi
        if [[ -n "$value" ]]; then
            printf -v "$key" '%s' "$value"
        else
            unset "$key"
        fi
        config_describe "$key"
        if [[ "$key" == api_key ]]; then
            set_status "${CFG_LABEL} saved"
        elif [[ -n "$value" ]]; then
            set_status "${CFG_LABEL} set to ${value}"
        else
            set_status "${CFG_LABEL} cleared${CFG_DEFAULT:+, so the default (${CFG_DEFAULT}) applies}"
        fi
        apply_setting "$key"
    }

    edit_setting() {
        local key="${CONFIG_KEYS[$settings_sel]}"
        local current="${!key:-}" value="" rc=0
        config_describe "$key"

        if [[ "$key" == check_updates ]]; then
            # a yes/no setting is flipped in place
            if [[ "${current:-true}" == false ]]; then value=true; else value=false; fi
            save_setting "$key" "$value"
            return 0
        fi

        tput cup $(( term_rows - 1 )) 0
        tput el
        tput cnorm
        if [[ "$key" == api_key ]]; then
            read -r -s -p " New API key, not shown (empty to cancel): " value || value=""
            value="${value//[[:space:]]/}"
        else
            read -r -e -i "$current" -p " ${CFG_LABEL} (clear the line for the default): " value || value="$current"
            config_normalize "$key" "$value"
            value="$REPLY"
        fi
        tput civis
        needs_redraw=1

        if [[ "$value" == "$current" ]]; then
            set_status "Nothing changed"
            return 0
        fi
        if [[ -z "$value" ]]; then
            if [[ "$key" == api_key ]]; then
                set_status "Cancelled"
            else
                save_setting "$key" ""
            fi
            return 0
        fi
        if ! config_validate "$key" "$value"; then
            set_status "Not saved: ${REPLY}" 6
            return 0
        fi
        if [[ "$key" == api_key ]]; then
            # a key that ngrok rejects would leave the list empty, so try it first
            tput cup $(( term_rows - 1 )) 0
            tput el
            printf ' Checking the key with ngrok…'
            api_check_key "$value" || rc=$?
            if (( rc != 0 )); then
                set_status "Not saved: ${REPLY}" 8
                return 0
            fi
        fi
        save_setting "$key" "$value"
    }

    handle_settings_key() {
        local key="$1" last=$(( ${#CONFIG_KEYS[@]} - 1 ))
        case "$key" in
            ESC|q|e)
                mode=list
                needs_redraw=1 ;;
            UP|k)
                if (( settings_sel > 0 )); then (( settings_sel-- )) || true; needs_redraw=1; fi ;;
            DOWN|j)
                if (( settings_sel < last )); then (( settings_sel++ )) || true; needs_redraw=1; fi ;;
            HOME|g) settings_sel=0; needs_redraw=1 ;;
            END|G)  settings_sel=$last; needs_redraw=1 ;;
            ENTER)  edit_setting ;;
        esac
    }

    handle_key() {
        local key="$1"
        if [[ "$mode" == settings ]]; then
            handle_settings_key "$key"
            return 0
        fi
        case "$key" in
            q|Q) exit 0 ;;
            e)
                mode=settings
                needs_redraw=1 ;;
            UP|k)     move_sel -1 ;;
            DOWN|j)   move_sel 1 ;;
            PGUP)     move_sel "-$(page_size)" ;;
            PGDN)     move_sel "$(page_size)" ;;
            HOME|g)   move_sel "-${line_count}" ;;
            END|G)    move_sel "${line_count}" ;;
            a)        add_to_ssh_config ;;
            c|C)
                local addr
                addr="$(get_selected_addr)"
                if [[ -n "$addr" ]]; then
                    if clip_copy "$addr"; then
                        set_status "Copied: ${addr}"
                    else
                        set_status "No clipboard tool found (install xclip, xsel, or wl-copy)"
                    fi
                fi
                ;;
            s|S)
                local addr
                addr="$(get_selected_addr)"
                if [[ -n "$addr" ]]; then
                    local host port
                    host="${addr%%:*}"
                    port="${addr##*:}"
                    local user="${ssh_user:-}"
                    local ssh_cmd="ssh ${user:+${user}@}${host} -p ${port}"
                    if clip_copy "$ssh_cmd"; then
                        set_status "Copied: ${ssh_cmd}"
                    else
                        set_status "No clipboard tool found (install xclip, xsel, or wl-copy)"
                    fi
                fi
                ;;
        esac
    }

    # Turns the byte that read returned into a key name: read gives an empty
    # string for Enter, and \e starts an escape sequence.
    name_key() {
        if [[ -z "$key" ]]; then
            key=ENTER
        elif [[ "$key" == $'\x1b' ]]; then
            key="$(read_escape)"
        fi
    }

    # Reads the rest of an escape sequence (the \e is already consumed) and
    # prints a key name, or nothing for sequences we do not use.
    read_escape() {
        local seq="" ch=""
        while ch=""; read -rsn1 -t 0.05 ch 2>/dev/null || [[ -n "$ch" ]]; do
            seq+="$ch"
            if [[ "$seq" != "[" && "$seq" != "O" && "$ch" =~ [A-Za-z~] ]]; then break; fi
        done
        case "$seq" in
            "") echo ESC ;;  # nothing followed, so it was the Esc key itself
            "[A"|"OA") echo UP ;;
            "[B"|"OB") echo DOWN ;;
            "[5~") echo PGUP ;;
            "[6~") echo PGDN ;;
            "[H"|"OH"|"[1~"|"[7~") echo HOME ;;
            "[F"|"OF"|"[4~"|"[8~") echo END ;;
        esac
    }

    local lines=()
    local error=""
    local key got_key

    if (( ${#CONFIG_WARNINGS[@]} == 1 )); then
        set_status "${CONFIG_WARNINGS[0]}" 15
    elif (( ${#CONFIG_WARNINGS[@]} > 1 )); then
        set_status "The config file has ${#CONFIG_WARNINGS[@]} problems. To see them, quit and run: ngrok-status config get" 15
    fi

    start_fetch
    draw
    needs_redraw=0

    while true; do
        # on a timeout bash may still hand us a byte it had already read
        key=""
        got_key=0
        if read -rsn1 -t 0.2 key 2>/dev/null; then got_key=1; fi
        if (( got_key )) || [[ -n "$key" ]]; then
            name_key
            handle_key "$key"
            # A held key queues up repeats faster than we can draw. Take
            # everything that is waiting first, then draw once.
            # (read -t 0 only tests for input, so no byte can be lost
            # to a timeout that fires in the middle of a read)
            while read -t 0 2>/dev/null; do
                read -rsn1 key 2>/dev/null || break
                name_key
                handle_key "$key"
            done
        fi

        if (( fetching )); then
            collect_fetch || true
        elif (( SECONDS >= next_fetch )); then
            start_fetch
        fi
        check_for_update

        # clear expired status messages
        if [[ -n "$status_msg" ]] && (( SECONDS >= status_expire )); then
            status_msg=""
            needs_redraw=1
        fi
        if (( needs_redraw )); then
            draw
            needs_redraw=0
        fi
    done
}

# --- CLI ---

usage() {
    cat <<'EOF'
Usage: ngrok-status [command]

Commands:
  watch                  Launch the live TUI dashboard (default)
  setup                  Ask for the API key and the ssh settings
  config set <key> <val> Set a config value
  config unset <key>     Remove a config value, so that its default applies
  config get [key]       Show config values
  config path            Print config file path
  update                 Install the latest version over this one
  version                Print the version, and whether a newer one exists

In the dashboard, press e to change the settings.

Config keys:
  api_key                Your ngrok API key
  refresh_interval       Refresh interval in seconds (default: 5)
  ssh_user               Default SSH username for the 's' shortcut and new ssh config entries
  ssh_config             ssh config file to edit (default: ~/.ssh/config)
  alias_strip_prefix     Prefix dropped from the description when suggesting a Host alias
  check_updates          Set to false to stop the TUI from checking for new versions
EOF
}

case "${1:-watch}" in
    watch)
        watch_tui
        ;;
    config)
        case "${2:-}" in
            set)
                if [[ -z "${3:-}" || -z "${4:-}" ]]; then
                    echo "Usage: ngrok-status config set <key> <value>" >&2
                    exit 1
                fi
                config_set "$3" "$4"
                ;;
            unset)
                if [[ -z "${3:-}" ]]; then
                    echo "Usage: ngrok-status config unset <key>" >&2
                    exit 1
                fi
                config_unset "$3"
                ;;
            get)
                config_get "${3:-}"
                ;;
            path)
                echo "$CONFIG_FILE"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    setup)
        for cmd in curl jq; do
            if ! command -v "$cmd" &>/dev/null; then
                echo "Error: $cmd is required. Install it and try again." >&2
                exit 1
            fi
        done
        if [[ ! -t 0 ]]; then
            echo "Error: setup asks questions, so it needs a terminal." >&2
            echo "Without one, use: ngrok-status config set api_key <your-key>" >&2
            exit 1
        fi
        run_setup 0 || exit 1
        echo "  Run ngrok-status to start."
        ;;
    -h|--help|help)
        usage
        ;;
    -v|--version|version)
        echo "ngrok-status ${VERSION}"
        config_load
        if [[ "${check_updates:-true}" != false ]]; then
            latest="$(latest_version || true)"
            if [[ -n "$latest" ]] && version_gt "$latest" "$VERSION"; then
                echo "Version ${latest} is available. To update, run: ngrok-status update"
            fi
        fi
        ;;
    update)
        self_update
        ;;
    *)
        usage
        exit 1
        ;;
esac
